# The game itself is the three files in the repo root and has no build step.
# Everything below belongs to the Capacitor shell in mobile/.

mobile/node_modules/
# generated by `npm run copy` from index.html + three.min.js — never edit here
mobile/www/

# Capacitor copies www/ into the native project on every sync
mobile/android/app/src/main/assets/public/
mobile/android/app/src/main/assets/capacitor.config.json
mobile/android/app/src/main/assets/capacitor.plugins.json
mobile/android/capacitor-cordova-android-plugins/
mobile/android/app/capacitor.build.gradle
mobile/android/capacitor.settings.gradle

# Gradle / Android build output
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/.idea/
mobile/android/captures/
*.iml

# Signing material must never be committed
*.keystore
*.jks
keystore.properties

# macOS
.DS_Store

# Tooling scratch
.playwright-mcp/
