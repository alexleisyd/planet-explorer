<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon layer (Android 13+): the launcher tints this with the wallpaper
     palette, so it must be a flat silhouette — no gradients, one colour, and
     enough weight that the ring survives being drawn in a single tone. The ring
     is a whole ellipse here rather than a front/back pair, since a monochrome
     shape has no depth to imply. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:rotation="-19" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M22,54a32,10.5 0 1,0 64,0a32,10.5 0 1,0 -64,0z"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.4"
            android:strokeLineCap="round"/>
        <path
            android:pathData="M54,34a20,20 0 1,0 0,40a20,20 0 1,0 0,-40z"
            android:fillColor="#FFFFFFFF"/>
    </group>
</vector>
